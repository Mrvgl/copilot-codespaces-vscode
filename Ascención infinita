    def summon_with_coins(self):
        if self.coins < 500:
            return "No tienes suficientes monedas (500 requeridas)."
        self.summon_count += 1
        roll = random.random()
        cumulative = 0
        for rarity in range(1, 6):
            cumulative += self.rarity_probs[rarity]
            if roll <= cumulative:
                hero = Hero(rarity, random.choice(list(TRAITS.keys())))
                hero.game = self
                self.coins -= 500
                self.team.append(hero)
                return f"¡Has invocado a {hero.name} ({rarity}★) con monedas!"
        return "Error en invocación."

    def summon_with_gems(self):
        if self.gems < 50:
