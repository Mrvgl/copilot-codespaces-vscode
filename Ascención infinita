    def send_heroes_to_friend(self, friend_email, heroes):
        if "magic_transporter" not in self.lobby or self.lobby["magic_transporter"] == 0:
            return "Necesitas construir un transportador mágico."
        if friend_email not in USED_EMAILS:
            return "Ese amigo no tiene una partida activa."
        friend_game = Game(friend_email)
        if len(heroes) > 5:
            return "Máximo 5 héroes por viaje."
        eligible_mentors = [h for h in friend_game.team + list(friend_game.lobby_team.values()) if h.level >= 20]
        if not eligible_mentors:
            return "No hay héroes de nivel suficiente en el lobby del amigo."
        results = []
        for hero in heroes:
            mentor = random.choice(eligible_mentors)
            if hero in self.team:
                self.team.remove(hero)
            elif hero in self.lobby_team.values():
                del self.lobby_team[next(k for k, v in self.lobby_team.items() if v == hero)]
            results.append(hero.learn_from_hero(mentor))
        return f"Héroes enviados a {friend_email}:\n" + "\n".join(results)

    def trade_with_friend(self, friend_email, offer, request):
        if "magic_transporter" not in self.lobby or self.lobby["magic_transporter"] == 0:
            return "Necesitas construir un transportador mágico."
        if friend_email not in USED_EMAILS:
            return "Ese amigo no tiene una partida activa."
        if self.gems < 50:
            return "Necesitas 50 gemas para comerciar."
        friend_game = Game(friend_email)
        if offer["type"] == "hero":
            hero = next((h for h in self.team if h.name == offer["name"]), None)
            if not hero:
                return "Héroe no encontrado en tu equipo."
            self.team.remove(hero)
            friend_game.team.append(hero)
        elif offer["type"] in self.resources:
            if self.resources[offer["type"]] < offer["amount"]:
                return f"No tienes suficiente {offer['type']}."
            self.resources[offer["type"]] -= offer["amount"]
            friend_game.resources[offer["type"]] = friend_game.resources.get(offer["type"], 0) + offer["amount"]
        if request["type"] == "hero":
            hero = next((h for h in friend_game.team if h.name == request["name"]), None)
            if not hero:
                return "Héroe no encontrado en el equipo del amigo."
            friend_game.team.remove(hero)
            self.team.append(hero)
        elif request["type"] in friend_game.resources:
            if friend_game.resources[request["type"]] < request["amount"]:
                return f"El amigo no tiene suficiente {request['type']}."
            friend_game.resources[request["type"]] -= request["amount"]
            self.resources[request["type"]] = self.resources.get(request["type"], 0) + request["amount"]
        self.gems -= 50
        return f"Comercio con {friend_email} completado: Ofreciste {offer['type']} ({offer.get('name', offer['amount'])}), recibiste {request['type']} ({request.get('name', request['amount'])})."

