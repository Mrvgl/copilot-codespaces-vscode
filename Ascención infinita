class Hero:
    def __init__(self, rarity, trait):
        self.name = self.random_name()
        self.rarity = rarity
        self.trait = trait
        base_stats = rarity * 5
        self.strength = random.randint(base_stats, base_stats + 5)
        self.agility = random.randint(base_stats, base_stats + 5)
        self.intelligence = random.randint(base_stats, base_stats + 5)
        self.charisma = random.randint(base_stats, base_stats + 5)
        self.mana = random.randint(base_stats, base_stats + 10)
        self.energy = self.rarity * 20
        self.resilience = random.randint(base_stats, base_stats + 5)
        self.morale = 50
        self.level = 1
        self.exp = 0
        self.stardust = 0
        self.work_stress = 0
        self.on_strike = False
        self.mastery = 0
        self.weapon = random.choice(["Espada", "Arco", "Báculo", "Lanza", "Daga", "Escudo"])
        self.combat_skill = self.generate_skill(rarity) if random.random() < (0.2 + rarity * 0.1) else None
