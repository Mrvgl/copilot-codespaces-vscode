    def coin_dungeon(self):
        eligible_heroes = [h for h in self.team if h.level >= 10]
        if len(eligible_heroes) < 5:
            return "Necesitas 5 héroes con nivel 10 o superior."
        today = datetime.now().day
        if hasattr(self, "last_coin_dungeon") and self.last_coin_dungeon == today:
            return "Ya exploraste la mazmorra de monedas hoy."
        self.last_coin_dungeon = today
        coins_earned = self.floor * 100 * 5
        self.coins += coins_earned
        for hero in eligible_heroes[:5]:
            hero.gain_exp(50, self.floor)
        self.team = [h for h in self.team if h not in eligible_heroes[:5]] + eligible_heroes[:5]
        return f"Exploración de mazmorra de monedas completada. Ganaste {coins_earned} monedas."

    def daily_dungeon(self, teams):
        today = datetime.now().day
        if hasattr(self, "last_dungeon") and self.last_dungeon == today:
            return "Ya hiciste la mazmorra diaria."
        self.last_dungeon = today
        bonus = 1.0 + 0.1 * sum(1 for t in teams for h in t if h.non_combat_skill == "Gestión de Recursos")
        total_heroes = sum(len(t) for t in teams)
        for team in teams:
            if len(team) > 5:
                return "Cada equipo debe tener máximo 5 héroes."
            for hero in team:
                hero.gain_exp(20, self.floor)
                hero.update_work_stress(10)
                if random.random() < 0.01:
                    hero.stardust += 1
                    print(f"¡{hero.name} encuentra Polvo Estelar en la mazmorra!")
        self.resources["wood"] += int((random.randint(5, 15) - 10) * bonus * total_heroes)
        self.resources["ore"] += int((random.randint(5, 15) - 10) * bonus * total_heroes)
        self.resources["food"] += int(random.randint(5, 15) * bonus * total_heroes)
        return f"Mazmorra diaria completada con {len(teams)} equipo(s). Recursos obtenidos."

    def practice_combat(self):
        if self.lobby["training_ground"] == 0:
            return "No hay campo de entrenamiento construido."
        results = []
        for hero in self.team[:5]:
            results.append(hero.train_weapon())
        return "\n".join(results) + "\nCombate de práctica completado."

    def start_building(self, facility):
        if facility not in self.lobby:
            return "Instalación no válida."
        if self.lobby[facility] >= 5:
            return "Instalación al máximo nivel."
        cost_wood = (self.lobby[facility] + 1) * 20
        cost_ore = (self.lobby[facility] + 1) * 20
        if self.resources["wood"] < cost_wood or self.resources["ore"] < cost_ore:
            return "No tienes suficientes recursos."
        self.resources["wood"] -= cost_wood
        self.resources["ore"] -= cost_ore
        self.building_times[facility] = 3
        return f"Construcción de {facility} iniciada. Tiempo restante: 3 turnos."

    def accelerate_building(self, facility):
        if facility not in self.building_times or self.building_times[facility] == 0:
            return "No hay construcción en curso para este edificio."
        if self.gems < 50:
            return "No tienes suficientes gemas (50 requeridas)."
        self.gems -= 50
        self.lobby[facility] += 1
        del self.building_times[facility]
        return f"Construcción de {facility} acelerada con 50 gemas. Nuevo nivel: {self.lobby[facility]}."

    def assign_to_lobby(self, hero_name, facility, task_type):
        hero = next((h for h in self.team if h.name == hero_name), None)
        if not hero:
            return "Héroe no encontrado."
        if facility not in self.lobby:
            return "Instalación no válida."
        if self.lobby[facility] == 0:
            return "Esa instalación no está construida."
        tasks = {
            "Cocinar con Cuidado": {"effect": "morale", "value": 15, "time": 2, "desc": "cocina cuidadosamente para el equipo"},
            "Forjar con Prisa": {"effect": "strength", "value": 10, "time": 1, "penalty": -5, "desc": "forja un arma con prisa"},
            "Reparar con Arte": {"effect": "facility_level", "value": 1, "time": 3, "desc": "repara la estructura con arte"}
        }
        if task_type not in tasks:
            return "Tarea no válida."
        task = tasks[task_type]
        total_heroes = len(self.team) + len(self.lobby_team)
        required_workers = max(1, total_heroes // 10)
        current_workers = sum(1 for f, h in self.lobby_team.items() if f == facility)
        if facility in ["kitchen", "dormitory"] and current_workers >= required_workers:
            return f"{facility} ya tiene suficientes trabajadores ({required_workers})."
        self.team.remove(hero)
        self.lobby_team[facility] = hero
        if facility in self.facility_requirements:
            self.facility_requirements[facility] = required_workers
        if task["effect"] == "morale":
            for h in self.team + list(self.lobby_team.values()):
                h.morale += task["value"]
        elif task["effect"] == "strength":
            hero.strength += task["value"]
            hero.resilience += task.get("penalty", 0)
        elif task["effect"] == "facility_level":
            self.lobby[facility] = min(5, self.lobby[facility] + task["value"])
        self.building_times[facility] = task["time"]
        return f"{hero.name} {task['desc']} en {facility}."

    def craft_item(self, item_type, ore_amount):
        if "forge" not in self.lobby_team:
            return "No hay héroe asignado a la herrería."
        craftsman = self.lobby_team["forge"]
        if self.lobby["forge"] == 0:
            return "No hay herrería construida."
        if self.resources["ore"] < ore_amount:
            return f"No tienes suficiente mineral (requiere {ore_amount})."
        max_floor = max(self.cleared_floors, default=0)
        quality = min(ore_amount // 10, self.lobby["forge"] * 5 + self.facility_upgrades["forge"] * 5)
        bonus = quality * 2
        if craftsman.non_combat_skill == "Artesanía Básica":
            bonus = int(bonus * 1.2)
        if "Maestro Artesano" in NON_COMBAT_SKILLS:
            bonus = int(bonus * 1.2)
        self.resources["ore"] -= ore_amount
        item_types = {
            "Dañino": [
                {"name": "Espada de Fuego Forjada", "bonus": bonus, "min_floor": 0},
                {"name": "Hoja Estelar", "bonus": bonus + 10, "min_floor": 75}
            ],
            "Defensivo": [
                {"name": "Escudo de Hierro Reforzado", "bonus": bonus, "min_floor": 0},
                {"name": "Armadura del Vacío", "bonus": bonus + 15, "min_floor": 90}
            ],
            "Curativo": [
                {"name": "Báculo de Vida Sanador", "bonus": bonus, "min_floor": 0},
                {"name": "Cetro Celestial", "bonus": bonus + 10, "min_floor": 75}
            ],
            "Encantado": [
                {"name": "Reliquia Astral", "bonus": bonus + 10, "min_floor": 75}
            ]
        }
        if item_type == "Encantado" and self.lobby["forge"] < 2:
            return "Necesitas herrería nivel 2 para equipo encantado."
        if item_type == "Encantado" and "magic_workshop" not in self.lobby_team:
            return "Necesitas un ingeniero mágico en el taller para equipo encantado."
        engineer = self.lobby_team.get("magic_workshop")
        if item_type == "Encantado" and engineer and "Alquimista" not in engineer.non_combat_skill:
            return "El ingeniero mágico debe ser Alquimista."
        available_items = [item for item in item_types[item_type] if max_floor >= item["min_floor"]]
        if not available_items:
            return "No hay ítems disponibles para este nivel de torre."
        item = random.choice(available_items)
        return {"name": item["name"], "type": item_type, "bonus": item["bonus"]}

