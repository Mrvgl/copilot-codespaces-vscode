    def synthesize(self, hero1_name, hero2_name):
        if "temple" not in self.lobby_team:
            return "No hay héroe asignado al templo para realizar la síntesis."
        if self.lobby["temple"] == 0:
            return "No hay templo construido."
        hero1 = next((h for h in self.team if h.name == hero1_name), None)
        hero2 = next((h for h in self.team if h.name == hero2_name), None)
        if not hero1 or not hero2 or hero1 == hero2:
            return "Héroes no válidos."
        if hero2.in_prison:
            return f"{hero2.name} está en la cárcel y no puede ser sintetizado."
        if hero1.rarity != hero2.rarity:
            return f"Ambos héroes deben tener la misma rareza ({hero1.rarity}★ != {hero2.rarity}★)."
        level_req = {1: 25, 2: 50, 3: 75, 4: 100}.get(hero1.rarity, 100)
        if hero1.stardust < 1:
            hero1.strength += hero2.strength // 2
            hero1.agility += hero2.agility // 2
            hero1.intelligence += hero2.intelligence // 2
            hero1.charisma += hero2.charisma // 2
            hero1.mana += hero2.mana // 2
            hero1.resilience += hero2.resilience // 2
            self.team.remove(hero2)
            return f"Síntesis parcial: {hero2.name} sacrificado. {hero1.name} mejora stats (falta polvo estelar)."
        if hero1.level < level_req:
            hero1.strength += hero2.strength // 2
            hero1.agility += hero2.agility // 2
            hero1.intelligence += hero2.intelligence // 2
            hero1.charisma += hero2.charisma // 2
            hero1.mana += hero2.mana // 2
            hero1.resilience += hero2.resilience // 2
            self.team.remove(hero2)
            return f"Síntesis parcial: {hero2.name} sacrificado. {hero1.name} mejora stats (nivel {hero1.level} < {level_req})."
        self.team.remove(hero2)
        hero1.rarity = min(5, hero1.rarity + 1)
        hero1.stardust -= 1
        hero1.strength += hero2.strength // 2
        hero1.agility += hero2.agility // 2
        hero1.intelligence += hero2.intelligence // 2
        hero1.charisma += hero2.charisma // 2
        hero1.mana += hero2.mana // 2
        hero1.resilience += hero2.resilience // 2
        hero1.combat_skill = hero1.generate_skill(hero1.rarity)
        for h in self.team + list(self.lobby_team.values()):
            h.morale -= 10
            h.morale = max(0, h.morale)
            print(h.write_diary("síntesis"))
        self.global_morale -= 10
        return f"Síntesis completa: {hero2.name} sacrificado. {hero1.name} ahora es {hero1.rarity}★. Moral general -10."

    def handle_strike(self, hero_name, action):
        hero = next((h for h in self.team + list(self.lobby_team.values()) if h.name == hero_name), None)
        if not hero:
            return "Héroe no encontrado."
        result = hero.resolve_strike(action)
        if action == "fear" and "Victoria" not in result:
            synthesis_count = sum(1 for h in self.team + list(self.lobby_team.values()) if h.morale < 30)
            if synthesis_count > 5:
                for h in self.team + list(self.lobby_team.values()):
                    h.morale -= 5
                return f"{result} Tensión en el ambiente: moral general -5."
        return result

    def decorate_lobby(self, decoration, amount=1):
        if decoration not in self.decorations:
            return "Decoración no válida."
        cost = {"fountain": 1000, "trees": 500, "benches": 750}[decoration] * amount
        if self.coins < cost:
            return f"No tienes suficientes monedas (requiere {cost})."
        self.coins -= cost
        self.decorations[decoration] += amount
        return f"Se han añadido {amount} {decoration}(s) al lobby."

    def relocate_facility(self, facility, new_location):
        if facility not in self.lobby or facility == "temple":
            return "Instalación no válida o templo no reubicable."
        if new_location not in ["Norte", "Este", "Sur", "Oeste", "Centro", "Suroeste", "Sudeste", "Noroeste"]:
            return "Ubicación no válida."
        if new_location in self.lobby_locations.values() and new_location != self.lobby_locations[facility]:
            return "Esa ubicación ya está ocupada."
        self.lobby_locations[facility] = new_location
        return f"{facility} reubicado a {new_location}."

    def upgrade_facility(self, facility):
        if facility not in self.lobby:
            return "Instalación no válida."
        if self.lobby[facility] == 0:
            return "Primero construye la instalación."
        if self.facility_upgrades[facility] >= 3:
            return "Instalación al máximo nivel de mejora."
        cost = (self.facility_upgrades[facility] + 1) * 500
        if self.coins < cost:
            return f"No tienes suficientes monedas (requiere {cost})."
        self.coins -= cost
        self.facility_upgrades[facility] += 1
        return f"{facility} mejorada a nivel {self.facility_upgrades[facility]}. Nuevas opciones disponibles."

