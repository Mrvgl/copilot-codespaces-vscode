        self.non_combat_skill = random.choice(NON_COMBAT_SKILLS)
        self.gender = random.choice(["Masculino", "Femenino"])
        self.mbti = random.choice(["INTJ", "ENTP", "ISFJ", "ESTJ", "INFP", "ESFP", "ISTP", "ENFJ"])
        self.body_type = random.choice(["Esbelto", "Musculoso", "Robusto", "Frágil"])
        self.fitness = 50
        self.friends = []
        self.romance = None
        self.quirk = random.choice(["TOC (ordena todo)", "Habla solo", "Colecciona piedras", "Canta mal", "Miedo a la oscuridad"])
        self.hp = self.resilience * 10
        self.max_hp = self.hp
        self.status_effects = []
        self.learning_from = None
        self.strategy = None
        self.weather_preference = random.choice(list(WEATHER_TYPES.keys()))
        self.position = None
        self.equipment = None
        self.skill_tree = {"Ofensiva": [], "Defensiva": [], "Soporte": []}
        self.skill_points = 0
        self.fatigue = 0
        self.priority = None
        self.relic = None
        self.alliance = None
        self.affinities = {}
        self.diary = []
