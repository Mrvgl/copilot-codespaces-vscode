        if choice == 0:
            return "Saliste del mercado negro."
        item = items[self.black_market_week][choice - 1]
        if item["type"] == "summon" and self.gems < item["cost"]:
            return "No tienes suficientes gemas."
        elif item["type"] != "summon" and self.coins < item["cost"]:
            return "No tienes suficientes monedas."
        if item["type"] == "summon":
            self.gems -= item["cost"]
            hero = Hero(item["rarity"], random.choice(list(TRAITS.keys())))
            hero.game = self
            self.team.append(hero)
