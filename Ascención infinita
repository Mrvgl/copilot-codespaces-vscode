    def random_name(self):
        parts = [
            random.choice(NAME_PREFIXES),
            random.choice(NAME_MIDDLES) if random.random() < 0.7 else "",
            random.choice(NAME_SUFFIXES),
            random.choice(NAME_TITLES) if random.random() < 0.3 else ""
        ]
        return "".join(parts).strip()

    def apply_trait(self):
        trait_effects = TRAITS[self.trait]
        self.strength += trait_effects.get("strength_bonus", 0)
        self.agility += trait_effects.get("agility_bonus", 0)
        self.intelligence += trait_effects.get("intelligence_bonus", 0)
        self.charisma += trait_effects.get("charisma_bonus", 0) + trait_effects.get("charisma_penalty", 0)
        self.mana += trait_effects.get("mana_bonus", 0) + trait_effects.get("mana_penalty", 0)
        self.resilience += trait_effects.get("resilience_bonus", 0)
        self.morale += trait_effects.get("morale_bonus", 0)

    def apply_weather_effect(self):
        global current_weather
        weather = WEATHER_TYPES[current_weather]
        morale_change = weather["morale"]
        stress_change = weather["stress"]
        if self.weather_preference == current_weather:
            morale_change += 10
            stress_change -= 5
        self.morale += morale_change
        self.work_stress += stress_change
        self.morale = max(0, min(100, self.morale))
        self.work_stress = max(0, min(100, self.work_stress))
        return f"{self.name} reacciona al clima {current_weather}: Moral {'+' if morale_change >= 0 else ''}{morale_change}, Estrés {'+' if stress_change >= 0 else ''}{stress_change}."

    def generate_skill(self, rarity):
        prefixes = ["Golpear", "Lanzar", "Conjurar"]
        connectors = ["con Fuerza", "con Precisión", "con Velocidad"]
        suffixes = ["Directo", "de Área", "Curvo"]
        if rarity <= 2:
            action = random.choice(prefixes)
            connector = random.choice(connectors)
            target = random.choice(suffixes)
            mana_cost = random.randint(5, 15)
            energy_cost = random.randint(10, 20)
            power = random.randint(10, 25)
            effect = random.choice(["Dañino", "Debilitante"])
            name = f"{action} {connector} {target}"
        elif rarity <= 4:
            action = random.choice(INTERMEDIATE_ACTIONS)
            connector = random.choice(["con Ardor", "con Frío", "con Misterio"])
            target = random.choice(INTERMEDIATE_TARGETS)
            mana_cost = random.randint(20, 40)
            energy_cost = random.randint(25, 50)
            power = random.randint(30, 60)
            effect = random.choice(["Dañino", "Curativo", "Defensivo"])
            name = f"{action} {connector} {target}"
        else:
            action = random.choice(ADVANCED_ACTIONS)
            connector = random.choice(["con Poder Divino", "con Furia Eterna", "con Sombra"])
            target = random.choice(ADVANCED_TARGETS)
            mana_cost = random.randint(50, 100)
            energy_cost = random.randint(60, 120)
            power = random.randint(70, 150)
            effect = random.choice(["Dañino", "Curativo", "Defensivo"])
            name = f"{action} {connector} {target}"
        return {"name": name, "power": power, "mana_cost": mana_cost, "energy_cost": energy_cost, "effect": effect}

    def unlock_advanced_skill(self, skill_type, game):
        max_floor = max(game.cleared_floors, default=0)
        combat_skills = {
            "Tormenta Devastadora": {"min_floor": 75, "power": 100, "mana_cost": 80, "energy_cost": 100, "effect": "Dañino", "desc": "desata una tormenta que arrasa todo"},
            "Escudo Celestial": {"min_floor": 75, "power": 50, "mana_cost": 60, "energy_cost": 80, "effect": "Defensivo", "desc": "invoca un escudo protector celestial"},
            "Llamada del Vacío": {"min_floor": 90, "power": 120, "mana_cost": 100, "energy_cost": 120, "effect": "Debilitante", "desc": "suma a los enemigos en el vacío"}
        }
        non_combat_skills = {
            "Maestro Artesano": {"min_floor": 75, "desc": "aumenta un 20% la calidad de los objetos creados"},
            "Estratega Visionario": {"min_floor": 90, "desc": "mejora un 15% la precisión de las estrategias"}
        }
        skills = combat_skills if skill_type == "combat" else non_combat_skills
        skill_name = input(f"Elige una habilidad {skill_type} avanzada ({', '.join(k for k in skills if max_floor >= skills[k]['min_floor'])}): ")
        if skill_name not in skills or max_floor < skills[skill_name]["min_floor"]:
            return f"Habilidad no válida o no desbloqueada (requiere Piso {skills[skill_name]['min_floor']})."
        if skill_type == "combat":
            if skill_name in [s["name"] for s in self.advanced_combat_skills]:
                return "Ya tienes esta habilidad."
            self.advanced_combat_skills.append({"name": skill_name, **combat_skills[skill_name]})
        else:
            if skill_name in NON_COMBAT_SKILLS:
                return "Ya tienes esta habilidad."
            NON_COMBAT_SKILLS.append(skill_name)
        return f"{self.name} desbloquea '{skill_name}': {skills[skill_name]['desc']}."

    def apply_status_effect(self, effect):
        self.status_effects.append(effect)
        if effect == "Sangrado": self.hp -= int(self.max_hp * 0.1)
        elif effect == "Envenenado": self.hp -= int(self.max_hp * 0.05)
        elif effect == "Cegado": self.strength = int(self.strength * 0.7)
        elif effect == "Fractura": self.resilience = int(self.resilience * 0.6)
        elif effect == "Congelado": self.agility = int(self.agility * 0.5)
        elif effect == "Quemadura": self.hp -= int(self.max_hp * 0.08); self.morale -= 5
        elif effect == "Confusión": self.morale -= 10; self.agility = int(self.agility * 0.8)
        elif effect == "Petrificado": self.resilience = int(self.resilience * 0.7); self.agility = int(self.agility * 0.9)
        elif effect == "Encantado": self.charisma = int(self.charisma * 0.6); self.mana = int(self.mana * 0.8)
        elif effect == "Caos":
            random_effect = random.choice(["Sangrado", "Envenenado", "Cegado", "Fractura"])
            self.apply_status_effect(random_effect)
            return f"{self.name} sufre Caos -> {random_effect}."
        elif effect == "Maldición":
            self.strength = int(self.strength * 0.9); self.agility = int(self.agility * 0.9)
            self.intelligence = int(self.intelligence * 0.9); self.resilience = int(self.resilience * 0.9)
        elif effect == "Grito": self.morale -= 20; self.charisma = int(self.charisma * 0.5)
        elif effect == "Regeneración": self.hp += int(self.max_hp * 0.05)  # Para enemigos
        elif effect == "Enigma": self.intelligence = int(self.intelligence * 0.7)
        elif effect == "Embiste": self.hp -= int(self.max_hp * 0.15)
        elif effect == "Luz Cegadora": self.strength = int(self.strength * 0.8); self.agility = int(self.agility * 0.8)
        elif effect == "Drenaje": self.mana = int(self.mana * 0.8)
        elif effect == "Tormenta": self.agility = int(self.agility * 0.7)
        elif effect == "Escudo Rúnico": self.resilience += 20  # Para enemigos
        elif effect == "Miedo": self.morale -= 15
        elif effect == "Distorsión":
            stats = ["strength", "agility", "intelligence"]
            stat = random.choice(stats)
            setattr(self, stat, int(getattr(self, stat) * (random.uniform(0.8, 1.2))))
        return f"{self.name} sufre {effect}."

    def reset_status(self):
        self.hp = self.max_hp
        for injury in self.injuries[:]:
            for stat, value in injury["effect"].items():
                setattr(self, stat, getattr(self, stat) - value)
            self.injuries.remove(injury)
        if "Cegado" in self.status_effects: self.strength = int(self.strength / 0.7)
        if "Fractura" in self.status_effects: self.resilience = int(self.resilience / 0.6)
        if "Congelado" in self.status_effects: self.agility = int(self.agility / 0.5)
        self.status_effects = []
        return f"{self.name} se ha curado completamente al volver al lobby."

    def apply_injury(self):
        if random.random() < 0.2:
            injuries = {
                "Fractura": {"effect": {"agility": -20}, "desc": "una fractura limita su movimiento"},
                "Ceguera": {"effect": {"strength": -15}, "desc": "la visión nublada afecta su precisión"},
                "Quemadura Grave": {"effect": {"hp": -int(self.max_hp * 0.1)}, "desc": "quemaduras graves debilitan su cuerpo"}
            }
            injury = random.choice(list(injuries.keys()))
            self.injuries.append({"type": injury, **injuries[injury]})
            for stat, value in injuries[injury]["effect"].items():
                setattr(self, stat, getattr(self, stat) + value)
            return f"{self.name} sufre {injuries[injury]['desc']}."
        return None

    def gain_exp(self, amount, enemy_level):
        level_diff = enemy_level - self.level
        exp_modifier = 1.0
        if level_diff < -5:
            exp_modifier = max(0.2, 1 + level_diff * 0.1)
        elif level_diff > 0:
            exp_modifier = 1 + level_diff * 0.2
        adjusted_exp = int(amount * exp_modifier)
        self.exp += adjusted_exp
        exp_needed = int(self.level * 100 * math.pow(1.05, self.level))
        stat_points = 0
        while self.exp >= exp_needed and self.level < 100:
            self.level += 1
            stat_points += 5
            self.exp -= exp_needed
            exp_needed = int(self.level * 100 * math.pow(1.05, self.level))
        if stat_points > 0:
            self.skill_points += stat_points // 5
            return f"{self.name} gana {adjusted_exp} EXP por contribución al daño. Nivel: {self.level}, EXP: {self.exp}/{exp_needed}. Puntos de habilidad: {self.skill_points}"
        return f"{self.name} gana {adjusted_exp} EXP por contribución al daño. Nivel: {self.level}, EXP: {self.exp}/{exp_needed}"

    def assign_stat_points(self, stat, points):
        optimal_stats = {
            "Espada": ["strength", "resilience"], "Arco": ["agility", "strength"],
            "Báculo": ["intelligence", "mana"], "Lanza": ["resilience", "strength"],
            "Daga": ["agility", "strength"], "Escudo": ["resilience", "strength"]
        }
        if stat not in ["strength", "agility", "intelligence", "resilience", "mana", "charisma"]:
            return "Estadística no válida."
        if stat not in optimal_stats[self.weapon] and points > 0:
            print(f"Advertencia: {stat} no es óptimo para {self.name} con {self.weapon}. Recomendado: {', '.join(optimal_stats[self.weapon])}.")
        if stat == "strength": self.strength += points
        elif stat == "agility": self.agility += points
        elif stat == "intelligence": self.intelligence += points
        elif stat == "resilience": self.resilience += points
        elif stat == "mana": self.mana += points
        elif stat == "charisma": self.charisma += points
        return f"{self.name} asigna {points} puntos a {stat}. Nuevo valor: {getattr(self, stat)}"

    def learn_skill(self):
        if self.combat_skill and random.random() < 0.1:
            self.combat_skill = self.generate_skill(self.rarity)
            return f"{self.name} mejora su habilidad a {self.combat_skill['name']}."
        elif not self.combat_skill or random.random() < (0.05 + self.rarity * 0.05):
            self.combat_skill = self.generate_skill(self.rarity)
            return f"{self.name} aprende {self.combat_skill['name']} por su cuenta."
        return None

    def adjust_fitness(self):
        if "entrena" in self.idle_behavior([self]):
            self.fitness += random.randint(1, 5)
            if self.fitness >= 80 and self.body_type in ["Esbelto", "Frágil"]:
                self.body_type = random.choice(["Musculoso", "Robusto"])
                return f"{self.name} ha mejorado su físico a {self.body_type}."
            self.fitness = min(100, self.fitness)
        elif random.random() < 0.1:
            self.fitness -= random.randint(1, 3)
            if self.fitness <= 20 and self.body_type in ["Musculoso", "Robusto"]:
                self.body_type = random.choice(["Esbelto", "Frágil"])
                return f"{self.name} ha perdido forma, ahora es {self.body_type}."
            self.fitness = max(0, self.fitness)
        return None

    def receive_gift(self, gift):
        if self.gift_count >= 3:
            return f"{self.name} ha alcanzado el límite de regalos (3). No puede recibir más."
        self.gift_count += 1
        preferences = {
            "INTJ": {"Tomo de Sabiduría": 10, "Muñeco de Madera": -5},
            "ENTP": {"Espada Enjoyada": 10, "Pastel de Miel": -5},
            "ISFJ": {"Pastel de Miel": 10, "Collar de Rubíes": -5},
            "ESTJ": {"Espada Enjoyada": 15, "Tomo de Sabiduría": -5},
            "INFP": {"Muñeco de Madera": 10, "Espada Enjoyada": -10},
            "ESFP": {"Collar de Rubíes": 10, "Tomo de Sabiduría": -5},
            "ISTP": {"Espada Enjoyada": 10, "Pastel de Miel": 0},
            "ENFJ": {"Pastel de Miel": 10, "Muñeco de Madera": -5}
        }
        morale_change = preferences[self.mbti].get(gift, 0)
        self.morale += morale_change
        self.morale = max(0, min(100, self.morale))
        if morale_change < 0:
            self.work_stress += 10
            return f"{self.name} recibe {gift} pero no le gusta. Moral {'+' if morale_change >= 0 else ''}{morale_change}, Estrés +10."
        return f"{self.name} recibe {gift}. Moral {'+' if morale_change >= 0 else ''}{morale_change}."

    def update_work_stress(self, work_amount):
        self.work_stress += work_amount
        if self.work_stress >= 80 and not self.on_strike:
            self.on_strike = True
            demand = random.choice(["menos trabajo", "mejor comida", "más descanso"])
            return f"{self.name} entra en huelga. Demanda: {demand}."
        self.work_stress = min(100, self.work_stress)
        return None

    def resolve_strike(self, action):
        if not self.on_strike:
            return f"{self.name} no está en huelga."
        if action == "fear":
            self.on_strike = False
            self.morale -= 20
            self.work_stress = 0
            return f"{self.name} asustado por intimidación. Huelga terminada, moral -20."
        elif action == "accept":
            self.on_strike = False
            self.morale += 10
            self.work_stress -= 30
            return f"{self.name} satisface su demanda. Huelga terminada, moral +10."
        return "Acción no válida."

    def train_weapon(self):
        weapon_training = {
            "Espada": ("Fuerza", 2),
            "Arco": ("Agilidad", 1),
            "Báculo": ("Inteligencia", 2),
            "Lanza": ("Resistencia", 2),
            "Daga": ("Agilidad", 2),
            "Escudo": ("Resistencia", 2)
        }
        stat, bonus = weapon_training[self.weapon]
        if stat == "Fuerza": self.strength += bonus
        elif stat == "Agilidad": self.agility += bonus
        elif stat == "Inteligencia": self.intelligence += bonus
        elif stat == "Resistencia": self.resilience += bonus
        mastery_cost = int(1 + self.mastery / 50)
        if self.mastery < 100:
            self.mastery += random.randint(1, 3) * mastery_cost
        if self.mastery >= 100 and self.combat_skill:
            self.mastery = 0
            old_skill = self.combat_skill
            rarity = min(5, self.rarity + 1)
            self.combat_skill = self.generate_skill(rarity)
            return f"{self.name} alcanza maestría 100 con {self.weapon}. Habilidad mejorada de {old_skill['name']} a {self.combat_skill['name']}."
        return f"{self.name} entrena con {self.weapon}. {stat} +{bonus}, Maestría: {self.mastery}"

    def generate_strategy(self, team, enemies):
        if not self.combat_skill:
            return f"{self.name} no tiene habilidad para planear."
        floor = team[0].game.floor if team else 1
        prefixes = ["Atacar", "Defender", "Esconderse", "Emboscar"]
        suffixes = ["en Vanguardia", "en Retaguardia", "a Izquierda", "a Derecha"]
        if floor in self.strategy_history and self.strategy_history[floor]["success"]:
            return f"{self.name} sugiere repetir: '{self.strategy_history[floor]['strategy']}' (funcionó antes)."
        else:
            strategy = f"{random.choice(prefixes)} {random.choice(suffixes)}"
            if random.random() < 0.3 and self.intelligence > 20:
                if len(enemies) > 3:
                    strategy = "Emboscar a Derecha"
                elif any(e.resilience > 50 for e in enemies):
                    strategy = "Defender en Retaguardia"
            self.strategy = strategy
            return f"{self.name} propone: '{strategy}'"

    def explore_floor(self, floor, mission_type):
        survival_chance = (self.strength + self.agility + self.resilience) / (floor * 10)
        if "Mapa Avanzado" in self.game.tech_tree["Exploration"]:
            survival_chance += 0.2
        info_quality = min(1.0, survival_chance)
        mission_difficulty = {"Exterminio": 1.0, "Supervivencia": 1.2, "Rescate": 1.5, "Doble Asalto": 1.8}.get(mission_type, 1.0)
        survival_chance /= mission_difficulty
        enemy_count = 1 + (floor // 5)
        if random.random() < survival_chance:
            info = f"{self.name} explora el Piso {floor}. Enemigos: {enemy_count}, Tipo: {mission_type}, Detalle: {int(info_quality * 100)}%."
            self.morale -= 10
            self.work_stress += 20
            return info + " Sobrevive."
        else:
            self.hp = 0
            return f"{self.name} explora el Piso {floor} pero muere. Info parcial: Enemigos: {enemy_count}, Tipo: {mission_type}."

