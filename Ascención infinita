    def retire_hero(self, hero_name):
        hero = next((h for h in self.team + list(self.lobby_team.values()) if h.name == hero_name), None)
        if not hero:
            return "Héroe no encontrado."
        if hero.level < 100 and len(hero.titles) < 2:
            return f"{hero.name} no cumple los requisitos para ser leyenda (Nivel 100 o 2+ títulos)."
        legacy = random.choice(["statue", "weapon"])
        if legacy == "statue":
            for h in self.team + list(self.lobby_team.values()):
                h.morale += 5
            print(f"{hero.name} se retira como leyenda. Una estatua en su honor da +5 moral permanente.")
        else:
            new_hero = random.choice(self.team)
            new_hero.combat_skill["power"] += 20
            print(f"{hero.name} se retira como leyenda. Su arma legendaria mejora el poder de {new_hero.name} en +20.")
        if hero in self.team:
            self.team.remove(hero)
            print(hero.customize_hero(nickname="el Legendario"))
        elif hero in self.lobby_team.values():
            del self.lobby_team[next(k for k, v in self.lobby_team.items() if v == hero)]
        return f"{hero.name} se ha convertido en leyenda."

