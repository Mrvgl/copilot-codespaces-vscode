    def remove_title_effects(self, title):
        effects = {
            "Matadragones": {"strength": 10, "resilience": 5},
            "Guardián de la Torre": {"resilience": 15, "morale": 10},
            "Estratega Brillante": {"intelligence": 10, "charisma": 5},
            "Salvador": {"mana": 15, "morale": 10},
            "Cazador de Sombras": {"agility": 10, "strength": 5}
        }
        stats = effects.get(title, {})
        self.strength -= stats.get("strength", 0)
        self.agility -= stats.get("agility", 0)
        self.intelligence -= stats.get("intelligence", 0)
        self.resilience -= stats.get("resilience", 0)
        self.mana -= stats.get("mana", 0)
        self.morale -= stats.get("morale", 0)

    def unlock_skill(self, branch, skill_name):
        if self.level < 25:
            return f"{self.name} necesita nivel 25 para desbloquear habilidades."
        skills = {
            "Ofensiva": {
                "Golpe Crítico": {"cost": 100, "effect": "crit_chance", "value": 0.1},
                "Furia": {"cost": 150, "effect": "damage_boost", "value": 0.15},
                "Ruptura": {"cost": 200, "effect": "armor_break", "value": 0.2}
            },
            "Defensiva": {
                "Escudo Vital": {"cost": 100, "effect": "hp_boost", "value": 0.1},
                "Resistencia": {"cost": 150, "effect": "effect_resist", "value": 0.15},
                "Contraataque": {"cost": 200, "effect": "counter", "value": 0.25}
            },
            "Soporte": {
                "Curación Leve": {"cost": 100, "effect": "heal", "value": 0.05},
                "Inspiración": {"cost": 150, "effect": "morale_boost", "value": 10},
                "Refuerzo": {"cost": 200, "effect": "team_boost", "value": 0.1}
            }
        }
        if branch not in skills or skill_name not in skills[branch]:
            return "Habilidad o rama no válida."
        skill = skills[branch][skill_name]
        if self.essence < skill["cost"]:
            return f"No tienes suficiente esencia ({skill['cost']} requerida)."
        if skill_name in self.skill_tree[branch]:
            return f"{self.name} ya tiene {skill_name}."
        self.essence -= skill["cost"]
        self.skill_tree[branch].append(skill_name)
        return f"{self.name} desbloquea {skill_name} en {branch} por {skill['cost']} esencia."

    def customize_hero(self, new_name=None, nickname=None, color=None, symbol=None):
        if new_name:
            self.name = new_name
        if nickname and self.level >= 10:
            self.nickname = nickname
        if color and color in ["Rojo", "Azul", "Verde", "Negro"]:
            self.style["color"] = color
        if symbol and symbol in ["Espada", "Escudo", "Estrella", "Llama"]:
            self.style["symbol"] = symbol
        return f"{self.name}{' ' + self.nickname if self.nickname else ''} ahora luce una armadura {self.style['color']} con un símbolo de {self.style['symbol']}."

    def social_interaction(self, target, interaction_type):
        interactions = {
            "Hablar con Calma en Privado": {"effect": "friendship", "value": 10, "stress": -5, "desc": "conversa tranquilamente en privado"},
            "Ayudar con Pasión en Trabajo": {"effect": "friendship", "value": 15, "stress": 5, "desc": "colabora apasionadamente en el trabajo"},
            "Competir con Humor en Público": {"effect": "friendship", "value": 15, "stress": 10, "desc": "compite con humor frente a todos"},
            "Hablar con Pasión en Público": {"effect": "charisma", "value": 5, "desc": "habla apasionadamente ante el grupo"},
            "Ayudar con Calma en Privado": {"effect": "morale", "value": 10, "desc": "ayuda con calma en un momento privado"}
        }
        if interaction_type not in interactions:
            return "Interacción no válida."
        effect = interactions[interaction_type]
        if "friendship" in effect and target.name not in self.friends:
            self.friends.append(target.name)
            target.friends.append(self.name)
        self.morale += effect.get("morale", 0)
        self.charisma += effect.get("charisma", 0)
        self.work_stress += effect.get("stress", 0)
        return f"{self.name} {effect['desc']} junto a {target.name}. Amistad +{effect.get('value', 0)}."

    def __str__(self):
        equipment_str = f"Equipo: {self.equipment['name']} (+{self.equipment['bonus']})" if self.equipment else "Equipo: Ninguno"
        status_str = f"Efectos: {', '.join(self.status_effects)}" if self.status_effects else "Efectos: Ninguno"
        strike_str = "En huelga" if self.on_strike else "Trabajando"
        skill_str = f"Habilidad Combate: {self.combat_skill['name']} (P:{self.combat_skill['power']}, M:{self.combat_skill['mana_cost']}, E:{self.combat_skill['energy_cost']})" if self.combat_skill else "Habilidad Combate: Ninguna"
        adv_skills_str = f"Habilidades Avanzadas: {', '.join(s['name'] for s in self.advanced_combat_skills)}" if self.advanced_combat_skills else "Habilidades Avanzadas: Ninguna"
        return (f"{self.name}{' ' + self.nickname if self.nickname else ''} ({self.rarity}★) - Rasgo: {self.trait} - MBTI: {self.mbti} - Género: {self.gender}\n"
                f"  Nivel: {self.level} EXP: {self.exp}/{self.level * 100 * math.pow(1.05, self.level)} Polvo Estelar: {self.stardust}\n"
                f"  Físico: {self.body_type} (Fitness: {self.fitness}) HP:{self.hp}/{self.max_hp} Moral:{self.morale} Maestría:{self.mastery}\n"
                f"  Arma: {self.weapon} F:{self.strength} A:{self.agility} I:{self.intelligence} C:{self.charisma} M:{self.mana} E:{self.energy} R:{self.resilience}\n"
                f"  {skill_str}\n  {adv_skills_str}\n"
                f"  Habilidad No Combate: {self.non_combat_skill} Estado: {strike_str} (Estrés: {self.work_stress})\n"
                f"  {equipment_str}\n  {status_str}\n"
                f"  Amigos: {', '.join(self.friends) or 'Ninguno'} | Romance: {self.romance or 'Ninguno'} | Quirk: {self.quirk}")

class Enemy:
    def __init__(self, floor, enemy_type=None):
        themes = {
            range(1, 5): {"type": "Goblin", "effect": "Sangrado"},
            range(5, 10): {"type": "Serpiente", "effect": "Envenenado"},
            range(10, 15): {"type": "Espectro", "effect": "Cegado"},
            range(15, 20): {"type": "Ogro", "effect": "Fractura"},
            range(20, 25): {"type": "Elemental", "effect": random.choice(["Congelado", "Quemadura"])},
            range(25, 30): {"type": "Arpía", "effect": "Confusión"},
            range(30, 35): {"type": "Golem", "effect": "Petrificado"},
            range(35, 40): {"type": "Súcubo", "effect": "Encantado"},
            range(40, 45): {"type": "Quimera", "effect": "Caos"},
            range(45, 50): {"type": "Caballero Negro", "effect": "Maldición"},
            range(50, 55): {"type": "Banshee", "effect": "Grito"},
            range(55, 60): {"type": "Hidra", "effect": "Regeneración"},
            range(60, 65): {"type": "Esfinge", "effect": "Enigma"},
            range(65, 70): {"type": "Minotauro", "effect": "Embiste"},
            range(70, 75): {"type": "Arconte", "effect": "Luz Cegadora"},
            range(75, 80): {"type": "Liche", "effect": "Drenaje", "intelligence": 30},
            range(80, 85): {"type": "Furia Alada", "effect": "Tormenta", "intelligence": 35},
            range(85, 90): {"type": "Gigante Rúnico", "effect": "Escudo Rúnico", "intelligence": 40},
            range(90, 95): {"type": "Espectro Ancestral", "effect": "Miedo", "intelligence": 45},
            range(95, 100): {"type": "Guardián del Vacío", "effect": "Distorsión", "intelligence": 50}
        }
        for floors, data in themes.items():
            if floor in floors:
                self.type = data["type"] if not enemy_type else enemy_type
                self.effect = data["effect"]
                self.intelligence = data.get("intelligence", random.randint(5, 15) * (1 + floor // 10))
                break
        difficulty = math.pow(1.05, floor)
        base_stats = {
            "Goblin": (5, 5), "Serpiente": (4, 6), "Espectro": (6, 4), "Ogro": (8, 8), "Elemental": (7, 5),
            "Arpía": (6, 7), "Golem": (9, 10), "Súcubo": (5, 6), "Quimera": (8, 8), "Caballero Negro": (10, 9),
            "Banshee": (7, 6), "Hidra": (8, 12), "Esfinge": (6, 8), "Minotauro": (12, 10), "Arconte": (10, 11),
            "Liche": (9, 7), "Furia Alada": (11, 8), "Gigante Rúnico": (13, 13), "Espectro Ancestral": (8, 10),
            "Guardián del Vacío": (12, 12)
        }
        self.name = f"{self.type} del Piso {floor}"
        self.strength = int(base_stats[self.type][0] * difficulty)
        self.resilience = int(base_stats[self.type][1] * difficulty)
        self.hp = int(self.resilience * 2 * (1 + floor / 50))
        self.state = "Normal"
        self.level = floor

    def react_to_situation(self, team_power, team_size, stealth_attack=False):
        enemy_power = self.strength + self.resilience
        if self.intelligence > 30:
            if team_power > enemy_power * 1.5 and random.random() < 0.4:
                self.state = "Retirada"
                return f"{self.name} se retira estratégicamente al verse superado."
            elif stealth_attack and random.random() < 0.6:
                self.strength = int(self.strength * 0.9)
                return f"{self.name} ajusta su posición tras ser sorprendido por un ataque sigiloso."
            elif team_size > 3 and random.random() < 0.5:
                self.resilience += 10
                return f"{self.name} refuerza su defensa ante un grupo numeroso."
        return f"{self.name} lucha con determinación."

    def __str__(self):
        return f"{self.name} (F:{self.strength} R:{self.resilience} HP:{self.hp} Efecto: {self.effect} Estado: {self.state})"

class Boss:
    def __init__(self, floor):
        self.type = random.choice(["Dragón", "Titán", "Necromante", "Fénix", "Rey Arconte"])
        self.name = f"{self.type} del Piso {floor}"
        difficulty = math.pow(1.05, floor)
        base_stats = {"Dragón": (20, 15), "Titán": (15, 25), "Necromante": (10, 10), "Fénix": (18, 12), "Rey Arconte": (25, 20)}
        self.strength = int(base_stats[self.type][0] * difficulty * 2)
        self.resilience = int(base_stats[self.type][1] * difficulty * 2)
        self.hp = int(self.resilience * 5 * (1 + floor / 20))
        self.effect = {"Dragón": "Quemadura", "Titán": "Fractura", "Necromante": "Cegado", "Fénix": "Quemadura", "Rey Arconte": "Distorsión"}[self.type]
        self.strategy_weakness = random.choice(["Ofensivo", "Defensivo", "Equilibrado"])
        self.state = "Normal"
        self.intelligence = random.randint(40, 50)
        self.charisma = random.randint(20, 40)
        self.level = floor

    def react_to_situation(self, team_power, team_size, stealth_attack=False):
        if team_power > (self.strength + self.resilience) * 1.5 and any(h.strategy and self.strategy_weakness.lower() in h.strategy.lower() for h in team):
            self.state = "Debilitado"
            self.strength = int(self.strength * 0.7)
            return f"{self.name} se debilita al ser atacado con su punto débil: {self.strategy_weakness}."
        elif stealth_attack and random.random() < 0.7:
            self.hp = int(self.hp * 0.9)
            return f"{self.name} retrocede ante un ataque sigiloso bien ejecutado."
        elif team_size > 3 and self.charisma > 30:
            self.strength += 15
            return f"{self.name} inspira a sus aliados con un rugido, aumentando su fuerza."
        elif self.intelligence > 45 and random.random() < 0.6:
            weakest = min(team, key=lambda h: h.hp)
            return f"{self.name} concentra su ataque en {weakest.name}, el más débil."
        return f"{self.name} evalúa la situación y lucha con astucia."

    def __str__(self):
        return f"{self.name} (F:{self.strength} R:{self.resilience} HP:{self.hp} Efecto: {self.effect} Estado: {self.state})"

