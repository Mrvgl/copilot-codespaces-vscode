    def summon_bundle(self, currency="coins"):
        cost = 4500 if currency == "coins" else 450
        if (currency == "coins" and self.coins < cost) or (currency == "gems" and self.gems < cost):
            return f"No tienes suficientes {currency} ({cost} requeridos)."
        self.summon_count += 10
        heroes = []
        for _ in range(10):
            roll = random.random()
            cumulative = 0
            for rarity in range(1, 6):
                cumulative += self.rarity_probs[rarity]
                if roll <= cumulative:
                    hero = Hero(rarity, random.choice(list(TRAITS.keys())))
                    hero.game = self
                    heroes.append(hero)
                    break
        if currency == "coins":
            self.coins -= cost
        else:
