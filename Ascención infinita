        status.append("Decoraciones: " + ", ".join(f"{k}: {v}" for k, v in self.decorations.items()))
        if self.building_times:
            status.append("Construcciones en curso: " + ", ".join(f"{k}: {v} turnos" for k, v in self.building_times.items()))
