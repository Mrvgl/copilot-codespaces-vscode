    def expand_lobby(self):
        cost_coins = self.lobby_floors * 5000
        cost_wood = self.lobby_floors * 100
        cost_ore = self.lobby_floors * 100
        if self.coins < cost_coins or self.resources["wood"] < cost_wood or self.resources["ore"] < cost_ore:
            return f"Recursos insuficientes: {cost_coins} monedas, {cost_wood} madera, {cost_ore} mineral."
        self.coins -= cost_coins
        self.resources["wood"] -= cost_wood
        self.resources["ore"] -= cost_ore
        self.lobby_floors += 1
        self.lobby_capacity += 10
        return f"Lobby expandido a {self.lobby_floors} pisos. Capacidad total: {self.lobby_capacity} héroes."

    def build_prison(self):
        if self.summon_count < 10:
            return f"La cárcel se desbloquea tras 10 invocaciones ({self.summon_count}/10)."
        if self.lobby["prison"] > 0:
            return "Ya tienes una cárcel."
        cost_coins = 10000
        cost_ore = 500
        if self.coins < cost_coins or self.resources["ore"] < cost_ore:
            return f"Recursos insuficientes: {cost_coins} monedas, {cost_ore} mineral."
        self.coins -= cost_coins
        self.resources["ore"] -= cost_ore
        self.lobby["prison"] = 1
        return "Cárcel construida en el Sótano."

    def imprison_hero(self, hero_name):
        if "prison" not in self.lobby or self.lobby["prison"] == 0:
            return "No hay cárcel construida o no está desbloqueada (requiere 10 invocaciones)."
        hero = next((h for h in self.team + list(self.lobby_team.values()) if h.name == hero_name), None)
        if not hero:
            return "Héroe no encontrado."
        hero.in_prison = True
        hero.productivity = 50
        hero.morale -= 20
        if hero in self.team:
            self.team.remove(hero)
        elif hero in self.lobby_team.values():
            del self.lobby_team[next(k for k, v in self.lobby_team.items() if v == hero)]
        return f"{hero.name} encarcelado. Moral -20."

    def send_expedition(self, team, expedition_type):
        today = datetime.now().weekday()
        expeditions = {
            "Recolectar con Sigilo en Bosque": {"day": 0, "rewards": {"wood": 50}, "difficulty": 1.0, "desc": "recolecta madera silenciosamente en el bosque"},
            "Combatir con Fuerza en Cueva": {"day": 1, "rewards": {"gems": 20}, "difficulty": 1.2, "desc": "lucha con fuerza en las profundidades de la cueva"},
            "Explorar con Rapidez en Montaña": {"day": 2, "rewards": {"ore": 50}, "difficulty": 1.1, "desc": "explora rápidamente las alturas de la montaña"},
            "Recolectar con Fuerza en Ruinas": {"day": 3, "rewards": {"essence": 50}, "difficulty": 1.3, "desc": "extrae esencia con fuerza entre las ruinas"},
            "Combatir con Sigilo en Lago": {"day": 4, "rewards": {"essence": 100}, "difficulty": 1.4, "desc": "enfrenta enemigos sigilosamente junto al lago"},
            "Explorar con Fuerza en Volcán": {"day": 5, "rewards": {"ore": 70}, "difficulty": 1.5, "desc": "avanza con fuerza a través del volcán"},
            "Recolectar con Rapidez en Cielo": {"day": 6, "rewards": {"stardust": 1}, "difficulty": 1.6, "desc": "busca polvo estelar rápidamente en el cielo"}
        }
        if expedition_type not in expeditions:
            return "Expedición no válida."
        if today != expeditions[expedition_type]["day"]:
            return f"{expedition_type} solo está disponible los días {['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'][expeditions[expedition_type]['day']]}."
        if len(team) < 3 or len(team) > 5:
            return "El equipo debe tener entre 3 y 5 héroes."
        team_power = sum(h.strength + h.resilience for h in team)
        enemy_power = self.floor * 10 * expeditions[expedition_type]["difficulty"]
        if random.random() < (team_power / (enemy_power + 1)):
            for key, value in expeditions[expedition_type]["rewards"].items():
                if "Eficiencia de Recursos" in self.tech_tree["Lobby"]:
                    value = int(value * 1.2)
                self.resources[key] = self.resources.get(key, 0) + value
            return f"El equipo {expeditions[expedition_type]['desc']} con éxito. Recompensas obtenidas."
        else:
            for h in team:
                h.hp = 0
            return f"El equipo intentó {expeditions[expedition_type]['desc']} pero falló. Equipo perdido."

    def mentor_hero(self, mentor_name, apprentice_name):
        mentor = next((h for h in self.team + list(self.lobby_team.values()) if h.name == mentor_name), None)
        apprentice = next((h for h in self.team + list(self.lobby_team.values()) if h.name == apprentice_name), None)
        if not mentor or not apprentice:
            return "Mentor o aprendiz no encontrado."
        if mentor.level < 50 or mentor.level - apprentice.level < 20:
            return f"{mentor.name} necesita nivel 50 y 20 niveles más que {apprentice.name}."
        if self.essence < 100:
            return "Necesitas 100 esencia para la mentoría."
        self.essence -= 100
        if random.random() < 0.5:
            mentor_exp = int(mentor.exp * 0.05)
            mentor.exp -= mentor_exp
            apprentice.exp += int(mentor_exp * 2)
            return f"{mentor.name} transfiere {mentor_exp} EXP a {apprentice.name}."
        else:
            apprentice.combat_skill = mentor.generate_skill(min(apprentice.rarity, mentor.rarity))
            return f"{mentor.name} enseña una habilidad a {apprentice.name}: {apprentice.combat_skill['name']}."

