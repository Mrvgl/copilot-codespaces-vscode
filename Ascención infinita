                setattr(hero, item["stat"], getattr(hero, item["stat"]) + item["value"])
                hero.morale += item["penalty"]
                return f"{hero.name} usa {item['name']}. {item['stat'].capitalize()} +{item['value']}, Moral {item['penalty']}."
            return "Héroe no encontrado."
        else:
            self.coins -= item["cost"]
            return {"name": item["name"], "effect": item["effect"]}

