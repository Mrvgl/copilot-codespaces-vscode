    def research_tech(self, branch, tech_name):
        if "magic_workshop" not in self.lobby_team:
            return "Necesitas un héroe en el taller mágico."
        techs = {
            "Combat": {
                "Técnica de Combate": {"cost": 300, "effect": {"damage": 0.1}, "desc": "aumenta el daño en combate en un 10%"},
                "Resistencia Mejorada": {"cost": 500, "effect": {"resilience": 15}, "desc": "incrementa la resistencia de todos en 15"}
            },
            "Lobby": {
                "Eficiencia de Recursos": {"cost": 400, "effect": {"resource_gain": 0.2}, "desc": "aumenta la ganancia de recursos en un 20%"},
                "Moral Reforzada": {"cost": 600, "effect": {"morale_bonus": 10}, "desc": "otorga un bono permanente de +10 al moral"}
            },
            "Exploration": {
                "Mapa Avanzado": {"cost": 350, "effect": {"scout_bonus": 0.2}, "desc": "mejora la exploración en un 20%"},
                "Botín Mejorado": {"cost": 550, "effect": {"loot_bonus": 0.15}, "desc": "aumenta las recompensas de pisos en un 15%"}
            }
        }
        if branch not in techs or tech_name not in techs[branch]:
            return "Tecnología o rama no válida."
        tech = techs[branch][tech_name]
        if tech_name in self.tech_tree[branch]:
            return "Esta tecnología ya está desbloqueada."
        if self.essence < tech["cost"]:
            return f"No tienes suficiente esencia ({tech['cost']} requerida)."
        self.essence -= tech["cost"]
        self.tech_tree[branch].append(tech_name)
        if tech["effect"].get("morale_bonus"):
            for h in self.team + list(self.lobby_team.values()):
                h.morale += tech["effect"]["morale_bonus"]
        return f"Tecnología '{tech_name}' desbloqueada en {branch}: {tech['desc']}."

    def craft_potion(self, potion_type):
        if "magic_workshop" not in self.lobby_team:
            return "No hay héroe asignado al taller mágico."
        crafter = self.lobby_team["magic_workshop"]
        if crafter.weapon != "Báculo" and "Alquimista" not in crafter.non_combat_skill:
            return f"{crafter.name} no es mago ni alquimista."
        potions = {
            "Curación": {"cost_food": 50, "cost_essence": 100, "effect": "Cura 50 HP"},
            "Fuerza": {"cost_ore": 50, "cost_essence": 150, "effect": "+10 Fuerza temporal"},
            "Explosiva": {"cost_ore": 100, "cost_essence": 200, "effect": "Daño 50 a enemigos"},
            "Antídoto": {"cost_food": 30, "cost_essence": 80, "effect": "Elimina efectos negativos"}
        }
        if potion_type not in potions:
            return "Poción no válida."
        costs = potions[potion_type]
        if ("cost_food" in costs and self.resources["food"] < costs["cost_food"]) or \
           ("cost_ore" in costs and self.resources["ore"] < costs["cost_ore"]) or \
           self.essence < costs["cost_essence"]:
            return f"Recursos insuficientes para {potion_type}."
        if "cost_food" in costs: self.resources["food"] -= costs["cost_food"]
        if "cost_ore" in costs: self.resources["ore"] -= costs["cost_ore"]
        self.essence -= costs["cost_essence"]
        crafter.work_stress += 20
        return f"{crafter.name} crea una Poción de {potion_type} ({potions[potion_type]['effect']})."

