    def generate_rarity_probs(self):
        base = random.uniform(0.50, 0.65)
        remainder = 1 - base
        probs = {1: base, 2: remainder * random.uniform(0.50, 0.70), 3: 0, 4: 0, 5: 0}
        remainder -= probs[2]
        probs[3] = remainder * random.uniform(0.40, 0.60)
        remainder -= probs[3]
        probs[4] = remainder * random.uniform(0.30, 0.50)
        probs[5] = max(0.01, remainder - probs[4])
        return probs

    def initial_team(self):
        for _ in range(3):
            hero = Hero(1, random.choice(list(TRAITS.keys())))
            hero.game = self
            self.team.append(hero)

