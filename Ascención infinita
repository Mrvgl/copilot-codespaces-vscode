    def floor_mission(self, team_assignments=None):
        if len(self.team) > 5:
            self.team = self.team[:5]
            print("Equipo principal reducido a 5 héroes.")
        mission_types = {
            "Exterminio": {"desc": f"Elimina a {1 + (self.floor // 5)} enemigos.", "enemies": [Enemy(self.floor) for _ in range(1 + (self.floor // 5))]},
            "Supervivencia": {"desc": "Sobrevive 3 oleadas de enemigos.", "enemies": [Enemy(self.floor) for _ in range(3)]},
            "Rescate": {"desc": "Derrota al jefe y rescata a un héroe.", "enemies": [Enemy(self.floor, "Ogro")]}
        }
        if self.floor >= 15:
            mission_types["Doble Asalto"] = {"desc": f"Dos equipos deben derrotar {2 + (self.floor // 5)} enemigos.", "enemies": [Enemy(self.floor) for _ in range(2 + (self.floor // 5))], "optional": "Apoyo: +2 equipos para más recompensas"}
        mission = random.choice(list(mission_types.keys()))
        print(f"Misión en Piso {self.floor}: {mission_types[mission]['desc']}")
        enemies = mission_types[mission]["enemies"]
        result = self.combat(enemies)
        extra_teams = []
        if self.floor >= 15 and "optional" in mission_types[mission] and team_assignments:
            for team_key in ["doble asalto 1", "doble asalto 2"]:
                if team_key in self.aux_teams and len(self.aux_teams[team_key]) == 5:
                    extra_teams.append(self.aux_teams[team_key])
                    print(f"Equipo {team_key} enviado: {', '.join(h.name for h in self.aux_teams[team_key])}")
                    extra_result = self.combat([Enemy(self.floor) for _ in range(1 + (self.floor // 5))])
                    result += f"\nEquipo {team_key}: {extra_result}"
        if "Victoria" in result:
            coins_reward = int(self.floor * 100 * (1 + self.floor / 10))
            gems_reward = int(self.floor / 2 * (1 + self.floor / 20) * 10)
            if self.floor not in self.cleared_floors:
                self.coins += coins_reward * (2 if extra_teams else 1)
                self.gems += gems_reward * (2 if extra_teams else 1)
                self.cleared_floors.add(self.floor)
            else:
                self.coins += coins_reward // 10
            self.floor += 1
            self.essence += self.floor * 50
            for hero in self.team:
                print(hero.reset_status())
            if extra_teams:
                for team in extra_teams:
                    for hero in team:
                        print(hero.reset_status())
            if mission == "Rescate":
                new_hero = Hero(random.randint(1, 3), random.choice(list(TRAITS.keys())))
                new_hero.game = self
                self.team.append(new_hero)
                print(f"¡Héroe rescatado! {new_hero.name} se une al equipo.")
        else:
            for hero in self.lobby_team.values():
                hero.morale = max(0, hero.morale - 30)
            self.initial_team()
            print("Se ha generado un nuevo equipo inicial.")
            for hero in self.team:
                print(hero.reset_status())
        print(result)
        return result

    def send_scout(self, hero_name, mission_type):
