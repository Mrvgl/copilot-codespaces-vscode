    def lobby_behavior(self):
        global current_weather
        results = []
        current_weather = random.choice(list(WEATHER_TYPES.keys()))
        results.append(f"Clima actual: {current_weather} - {WEATHER_TYPES[current_weather]['desc']}")
        all_heroes = self.team + list(self.lobby_team.values())
        self.day_night = "Noche" if self.day_night == "Día" else "Día"
        results.append(f"Ciclo actual: {self.day_night}")
        self.turn_count += 1
        if self.turn_count % 10 == 0:
            seasons = ["Primavera", "Verano", "Otoño", "Invierno"]
            self.season = seasons[(seasons.index(self.season) + 1) % 4]
            results.append(f"Nueva estación: {self.season}")
        season_effects = {
            "Primavera": {"weather_bias": ["Soleado", "Lluvioso"], "effect": {"morale": 5}},
            "Verano": {"weather_bias": ["Soleado", "Tormentoso"], "effect": {"damage": 0.1, "fatigue": 5}},
            "Otoño": {"weather_bias": ["Nublado", "Niebla"], "effect": {"agility": -0.05}},
            "Invierno": {"weather_bias": ["Nevado", "Congelado"], "effect": {"resilience": 10, "agility": -0.1}}
        }
        current_weather = random.choice(season_effects[self.season]["weather_bias"] + list(WEATHER_TYPES.keys()))
        for hero in all_heroes:
            results.append(hero.apply_weather_effect())
            if self.season == "Verano":
                hero.fatigue += 5
            elif self.season == "Invierno":
                hero.resilience += 10
                hero.agility = int(hero.agility * 0.9)
            elif self.season == "Primavera":
                hero.morale += 5
            elif self.season == "Otoño":
                hero.agility = int(hero.agility * 0.95)
            if self.day_night == "Día":
                hero.work_stress += 5
                if "entrena" in hero.idle_behavior(all_heroes):
                    hero.fitness += int(hero.fitness * 0.1)
            else:
                hero.morale += 15
                if hero.quirk == "Miedo a la oscuridad":
                    hero.morale -= 20
            behavior = hero.idle_behavior(all_heroes)
            results.append(behavior)
            if "batalla a muerte" in behavior:
                other_name = behavior.split("desafía a ")[1].split(" ")[0]
                other = next((h for h in all_heroes if h.name == other_name), None)
                if other and random.random() < 0.3:
                    winner = random.choice([hero, other])
                    loser = hero if winner == other else other
                    all_heroes.remove(loser)
                    if loser in self.team: self.team.remove(loser)
                    elif loser in self.lobby_team.values(): del self.lobby_team[next(k for k, v in self.lobby_team.items() if v == loser)]
                    results.append(f"Duelo aprobado: {winner.name} derrota a {loser.name}. {loser.name} muere.")
            if random.random() < 0.3:
                results.append(hero.suggest_team_change(self.team))
            if hero.priority and random.random() < (0.9 if hero.morale > 30 else 0.5):
                if hero.priority["condition"] == "fatiga alta" and hero.fatigue > 50:
                    results.append(f"{hero.name} descansa por fatiga alta según su prioridad.")
                    hero.fatigue = max(0, hero.fatigue - 20)
                elif hero.priority["condition"] == "siempre" and "entrenar" in hero.priority["action"].lower():
                    results.append(f"{hero.name} entrena por su prioridad constante.")
                    hero.fitness += 5
            elif hero.priority and hero.morale <= 30:
                results.append(f"{hero.name} ignora su prioridad por baja moral.")
            unproductive = [h for h in self.team if h not in self.lobby_team.values() and not h.in_prison]
            for hero in all_heroes:
                is_assigned = hero in self.lobby_team.values() or hero.in_prison
                riot = hero.update_productivity(is_assigned)
                if riot:
                    results.append(riot)
                    if random.random() < 0.5:
                        stolen_resource = random.choice(["wood", "ore", "food"])
                        stolen_amount = random.randint(5, 20)
                        self.resources[stolen_resource] = max(0, self.resources[stolen_resource] - stolen_amount)
                        results.append(f"{hero.name} roba {stolen_amount} de {stolen_resource}.")
            if self.decorations["fountain"] > 0 and random.random() < 0.2:
                couple = [h for h in all_heroes if h.romance]
                if len(couple) >= 2:
                    h1, h2 = random.sample(couple, 2)
                    if h1.romance == h2.name:
                        results.append(f"{h1.name} y {h2.name} tienen una cita cerca de la fuente.")
                        h1.fatigue = max(0, h1.fatigue - 20)
                        h2.fatigue = max(0, h2.fatigue - 20)
        self.global_morale = sum(h.morale for h in all_heroes) // max(1, len(all_heroes))
        if self.global_morale <= 0:
            if random.random() < 0.5:
                remaining_heroes = self.team + list(self.lobby_team.values())
                self.team = []
                self.lobby_team = {}
                self.initial_team()
                self.global_morale = 50
                self.cleared_floors.clear()
                self.floor = 1
                results.append(f"¡Deserción masiva! Los héroes abandonan {self.lobby_name}. Solo quedan ruinas y un nuevo equipo inicial.")
            else:
                rebels = [h for h in all_heroes if random.random() < 0.7]
                for rebel in rebels:
                    if rebel in self.team:
                        self.team.remove(rebel)
                    elif rebel in self.lobby_team.values():
                        del self.lobby_team[next(k for k, v in self.lobby_team.items() if v == rebel)]
                    for res in ["wood", "ore", "food"]:
                        self.resources[res] = max(0, self.resources[res] - 20)
                self.global_morale = 20
                results.append(f"¡Rebelión total! {', '.join(h.name for h in rebels)} saquean {self.lobby_name} y huyen. Recursos -20, Moral global reiniciado a 20.")
        return "\n".join(results)

    def show_status(self):
