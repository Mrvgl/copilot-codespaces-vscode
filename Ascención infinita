    def equip_item(self, item):
        self.equipment = item
        if self.combat_skill and self.combat_skill["effect"] == item["type"]:
            self.strength += item["bonus"] if item["type"] == "Dañino" else 0
            self.resilience += item["bonus"] if item["type"] == "Defensivo" else 0
            self.mana += item["bonus"] if item["type"] in ["Curativo", "Aumenta", "Debilitante"] else 0
            return f"{self.name} equipa {item['name']} (+{item['bonus']} a stat correspondiente)."
        else:
            penalty = item["bonus"] // 2
            self.strength -= penalty if item["type"] == "Dañino" else 0
            self.resilience -= penalty if item["type"] == "Defensivo" else 0
            self.mana -= penalty if item["type"] in ["Curativo", "Aumenta", "Debilitante"] else 0
            return f"{self.name} equipa {item['name']} mal adaptado (-{penalty} a stat correspondiente)."

    def learn_from_hero(self, mentor):
        if mentor.level - self.level < 20:
            return f"{self.name} no puede aprender de {mentor.name}: diferencia de nivel insuficiente."
        self.learning_from = mentor.name
        stat_boost = random.choice(["strength", "agility", "resilience", "intelligence"])
        boost_amount = mentor.level // 10
        if stat_boost == "strength": self.strength += boost_amount
        elif stat_boost == "agility": self.agility += boost_amount
        elif stat_boost == "resilience": self.resilience += boost_amount
        elif stat_boost == "intelligence": self.intelligence += boost_amount
        return f"{self.name} aprende de {mentor.name}. {stat_boost.capitalize()} +{boost_amount}."

    def suggest_team_change(self, team):
        if len(team) != 5:
            return f"{self.name} dice: 'El equipo debe ser de 5.'"
        friends_in_team = sum(1 for h in team if h.name in self.friends)
        if friends_in_team > 2:
            return f"{self.name} dice: 'Me gusta este equipo, mis amigos están aquí.'"
        strongest = max(team, key=lambda h: h.strength + (h.combat_skill["power"] if h.combat_skill else 0))
        if strongest != self and random.random() < 0.3:
            return f"{self.name} dice: 'Deberíamos cambiar a alguien por {strongest.name}, es más fuerte.'"
        return f"{self.name} dice: 'Este equipo parece decente.'"

    def equip_relic(self, relic):
        if self.level < relic["level_req"]:
            return f"{self.name} necesita nivel {relic['level_req']} para equipar {relic['name']} (Nivel actual: {self.level})."
        self.relic = relic
        return f"{self.name} equipa la reliquia {relic['name']}."

    def form_alliance(self, partner, alliance_type):
        if self.alliance or partner.alliance:
            return f"{self.name} o {partner.name} ya tienen una alianza."
        alliances = {
            "Danza de las Cuchillas": {"weapons": ["Espada", "Espada"], "effect": "dual_attack", "value": 0.2},
            "Muro Sanador": {"weapons": ["Báculo", "Escudo"], "effect": "defense_boost", "value": 25},
            "Furia Aérea": {"weapons": ["Arco", "Daga"], "effect": "speed_attack", "value": 0.15},
            "Lanza Sagrada": {"weapons": ["Lanza", "Báculo"], "effect": "heal_attack", "value": 0.1},
            "Sombra y Acero": {"weapons": ["Daga", "Escudo"], "effect": "stealth_defense", "value": 0.2},
            "Muro Inquebrantable": {"weapons": ["Lanza", "Escudo"], "effect": "tank_boost", "value": 30}
        }
        if alliance_type not in alliances or sorted([self.weapon, partner.weapon]) != sorted(alliances[alliance_type]["weapons"]):
            return f"No se puede formar {alliance_type} con {self.weapon} y {partner.weapon}."
        self.alliance = {"type": alliance_type, "partner": partner.name}
        partner.alliance = {"type": alliance_type, "partner": self.name}
        return f"{self.name} y {partner.name} forman la alianza {alliance_type}."

    def update_affinity(self, other_hero, change):
        if other_hero.name not in self.affinities:
            self.affinities[other_hero.name] = 0
        self.affinities[other_hero.name] = max(-50, min(50, self.affinities[other_hero.name] + change))
        if other_hero.name not in self.friends and self.affinities[other_hero.name] >= 20:
            self.friends.append(other_hero.name)
            other_hero.friends.append(self.name)
            self.write_diary("amistad")
        elif other_hero.name in self.friends and self.affinities[other_hero.name] < 0:
            self.friends.remove(other_hero.name)
            other_hero.friends.remove(self.name)
        return f"Afinidad de {self.name} hacia {other_hero.name}: {self.affinities[other_hero.name]}"

    def write_diary(self, event):
        emotions = {
            "victoria": "Feliz",
            "derrota": "Triste",
            "fiesta": "Feliz",
            "luto": "Triste",
            "síntesis": "Enojado",
            "amistad": "Feliz"
        }
        self.emotional_state = emotions.get(event, "Neutral")
        entry = f"Día {datetime.now().day}: {self.name} se siente {self.emotional_state.lower()} tras {event}."
        self.diary.append(entry)
        if self.emotional_state == "Feliz":
            self.morale += 5
        elif self.emotional_state == "Triste":
            self.morale -= 5
        elif self.emotional_state == "Enojado":
            self.work_stress += 10
        return entry

    def update_productivity(self, is_assigned):
        if not is_assigned:
            self.productivity -= random.randint(5, 15)
        else:
            self.productivity += random.randint(5, 10)
        self.productivity = max(0, min(100, self.productivity))
        if self.productivity < 30 and not self.in_prison and random.random() < 0.2:
            return f"{self.name} se amotina por baja productividad ({self.productivity})."
        return None

    def set_priority(self, action, condition):
        self.priority = {"action": action, "condition": condition}
        return f"{self.name} tiene prioridad: {action} cuando {condition}."

    def equip_title(self, title_name):
        if title_name not in self.titles:
            return f"{self.name} no tiene el título {title_name}."
